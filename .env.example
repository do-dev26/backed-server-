# ═══════════════════════════════════════════════════════════
#  FolioOS Backend — Environment Variables
#  Copy this file → .env and fill in your actual values
#  NEVER commit .env to git
# ═══════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
# NODE_ENV options: development | production | test

# ── Frontend URL (for CORS) ───────────────────────────────────
# Local dev:   http://localhost:3000
# Netlify:     https://your-site.netlify.app
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:5000

# ── Firebase Admin SDK ────────────────────────────────────────
# Steps to get these:
# 1. Go to Firebase Console → https://console.firebase.google.com
# 2. Select your project
# 3. Project Settings (gear icon) → Service Accounts tab
# 4. Click "Generate new private key" → download JSON file
# 5. Copy the values below from that JSON file

FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com

# IMPORTANT: The private key contains actual newlines.
# In .env file, replace each newline with \n (backslash-n)
# Wrap the entire key in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----\n"

# Firebase Realtime DB URL (optional — only if you use Realtime DB)
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# Firebase Storage bucket (optional)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# ── Cashfree Payments ─────────────────────────────────────────
# Steps to get these:
# 1. Go to https://merchant.cashfree.com → Sign up / Login
# 2. Complete KYC for production keys
# 3. Go to Developers → API Keys
# 4. Copy App ID and Secret Key

CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# Environment: TEST (sandbox) or PROD (production)
CASHFREE_ENV=TEST

# Cashfree Webhook Secret
# Set this in Cashfree Dashboard → Developers → Webhooks → Secret
CASHFREE_WEBHOOK_SECRET=your_webhook_secret_here

# ── App Config ────────────────────────────────────────────────
BASE_DOMAIN=folio.dev
APP_NAME=FolioOS

# ── Rate Limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_MAX=10
